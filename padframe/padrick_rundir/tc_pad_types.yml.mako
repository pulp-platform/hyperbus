      .tc_pad_orientation ( tc_pad_pkg::H              ),
      .tc_pad_config      ( tc_pad_config )
    ) ${instance_name} (
      .int_io ( `io_pad_internals )
    );

- name: PAD_VDD_IO_V
  description: "IO power domain VDD pad, vertical orientation"
