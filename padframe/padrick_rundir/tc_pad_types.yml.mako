${'#' * 17}
# PHYSICAL PADS
${'#' * 17}

- name: PAD_CORNER
  description: "corner pad"
  template: |
    tc_pad_corner #( .tc_pad_config ( tc_pad_config ) ) ${instance_name} ( .int_io ( `io_pad_internals ) );

${'#' * 29}
# DIGITAL INPUT/OUTPUT PADS
${'#' * 29}

- name: PAD_BIDIR_H
  description: "digital bidirectional input/output pad, horizontal orientation"
  pad_signals: &digital_bidir_pad_signals
    - name: pad2chip
      description: "Data output pin from padframe to chip"
      size: 1
      kind: output
      conn_type: dynamic
    - name: nand_out
      description: "NAND Tree Output signal"
      size: 1
      kind: output
      conn_type: dynamic
    - name: nand_in
      description: "NAND Tree Input signal"
      size: 1
      kind: input
      conn_type: dynamic
      default_reset_value: 0
      default_static_value: 1'b0
    - name: pad
      description: "Data external output"
      size: 1
      kind: pad
    - name: drive_strength
      description: "Programmable drive strength control signal, from 0 to ${2**ds_w - 1}"
      size: ${ds_w}
      kind: input
      conn_type: dynamic
      default_reset_value: 0
      default_static_value: ${ds_w}'b0
    - name: chip2pad
      description: "Data input pin from chip to padframe"
      size: 1
      kind: input
      conn_type: dynamic
      default_reset_value: 0
      default_static_value: 1'b0
    - name: pu_en
      description: "Pull-up enable signal, active high"
      size: 1
      kind: input
      conn_type: dynamic
      default_reset_value: 0
      default_static_value: 1'b0
    - name: pd_en
      description: "Pull-down enable signal, active high"
      size: 1
      kind: input
      conn_type: dynamic
      default_reset_value: 0
      default_static_value: 1'b0
    - name: input_en
      description: "Input enable signal, active high"
      size: 1
      kind: input
      conn_type: dynamic
      default_reset_value: 0
      default_static_value: 1'b0
    - name: schmitt_en
      description: "Schmitt enable signal, high: Schmitt Mode, low: CMOS Mode"
      size: 1
      kind: input
      conn_type: dynamic
      default_reset_value: 0
      default_static_value: 1'b0
    - name: slew_en
      description: "Slew rate control enable signal, active high"
      size: 1
      kind: input
      conn_type: dynamic
      default_reset_value: 0
      default_static_value: 1'b0
    - name: output_en
      description: "Output enable signal, active high"
      size: 1
      kind: input
      conn_type: dynamic
      default_reset_value: 0
      default_static_value: 1'b0
  template: |
    tc_pad_bidir #(
      .tc_pad_orientation ( tc_pad_pkg::H              ),
      .tc_pad_config      ( tc_pad_config )
    ) ${instance_name} (
      .pad_io           ( ${conn('pad')}            ),
      .pad2chip_o       ( ${conn('pad2chip')}       ),
      .input_en_i       ( ${conn('input_en')}       ),
      .pu_en_i          ( ${conn('pu_en')}          ),
      .pd_en_i          ( ${conn('pd_en')}          ),
      .schmitt_en_i     ( ${conn('schmitt_en')}     ),
      .nand_in_i        ( ${conn('nand_in')}        ),
      .nand_out_o       ( ${conn('nand_out')}       ),
      .chip2pad_i       ( ${conn('chip2pad')}       ),
      .output_en_i      ( ${conn('output_en')}      ),
      .slew_en_i        ( ${conn('slew_en')}        ),
      .drive_strength_i ( ${conn('drive_strength')} ),
      .int_io           ( `io_pad_internals         )
    );

- name: PAD_BIDIR_V
  description: "digital bidirectional input/output pad, vertical orientation"
  pad_signals: *digital_bidir_pad_signals
  template: |
    tc_pad_bidir #(
      .tc_pad_orientation ( tc_pad_pkg::V              ),
      .tc_pad_config      ( tc_pad_config )
    ) ${instance_name} (
      .pad_io           ( ${conn('pad')}            ),
      .pad2chip_o       ( ${conn('pad2chip')}       ),
      .input_en_i       ( ${conn('input_en')}       ),
      .pu_en_i          ( ${conn('pu_en')}          ),
      .pd_en_i          ( ${conn('pd_en')}          ),
      .schmitt_en_i     ( ${conn('schmitt_en')}     ),
      .nand_in_i        ( ${conn('nand_in')}        ),
      .nand_out_o       ( ${conn('nand_out')}       ),
      .chip2pad_i       ( ${conn('chip2pad')}       ),
      .output_en_i      ( ${conn('output_en')}      ),
      .slew_en_i        ( ${conn('slew_en')}        ),
      .drive_strength_i ( ${conn('drive_strength')} ),
      .int_io           ( `io_pad_internals         )
    );

