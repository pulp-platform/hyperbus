##
## Template for tc_pad_types.yml. The pad configuration is read from the yaml
## file given as `cfg_file`, e.g.:
##   mako-render --var cfg_file=configs/<tech>.yml tc_pad_types.yml.mako > tc_pad_types.yml
<%!
import yaml
%>\
<%
    cfg_file = context.get('cfg_file')
    if not cfg_file:
        raise SystemExit("missing pad config: pass --var cfg_file=configs/<tech>.yml")
    with open(cfg_file) as f:
        cfg = yaml.safe_load(f)

    ds_w  = cfg['ds_w']
    n_int = cfg['n_int']
    assert ds_w >= 1, "ds_w must be >= 1"
    assert n_int >= 0, "n_int must be >= 0"

    # Padrick evaluates ${...} in pad templates itself: emit them literally.
    instance_name = '${instance_name}'
    def conn(sig):
        return '${conn["%s"]}' % sig
%>\
# Copyright 2026 Fondazione Chips-IT.
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
#
# Author: Riccardo Fiorani Gallotta <riccardo.fiorani3@unibo.it>

# AUTOGENERATED from tc_pad_types.yml.mako with ${cfg_file}. Do not edit.

# This file defines generic pad primitives.
# It must be included in a modular configuration yaml file.

${'#' * 62}
# POWER MANAGEMENT PADS
#
# You MUST HAVE one and only one CONFIG_TC_PAD_DEF.
# WARNING: internal_signals are in IO power domain (1.8 V)!
${'#' * 62}

- name: CONFIG_TC_PAD_DEF
  description: "instantiation of config and internal wires for tc_pad modules"
  pad_signals:
% for i in range(n_int + 1):
    - name: internal_signals_${i}
      description: "IO pad internal signals for power sense and retention enable (IO power domain)"
      size: 1
      kind: pad
% endfor
    - name: retcin
      description: "Retention mode enable signal, active high (VVD power domain)"
      size: 1
      kind: input
      conn_type: dynamic
      default_reset_value: 0
      default_static_value: 1'b0
  template: |
    localparam tc_pad_pkg::tc_pad_config_t tc_pad_config = '{
        1'b${cfg['av_bidir_cell']},   //av_bidir_cell
        1'b${cfg['av_in_cell']},   //av_in_cell
        1'b${cfg['av_out_cell']},   //av_out_cell
        1'b${cfg['in_en_latch']},   //in_en_latch
        1'b${cfg['pu_pd_both_en']},   //pu_pd_both_en
        1'b${cfg['rt_en_ah']},   //rt_en_ah
        ${ds_w},      //ds_w
        ${n_int}       //n_int
    };

    wire io_pad_retcin;
    assign io_pad_retcin = ${conn('retcin')};
    `define io_pad_internals {${", ".join(conn('internal_signals_%d' % i) for i in reversed(range(n_int + 1)))}}

- name: PAD_PWR_MNG_H
  description: "power management pad, horizontal orientation"
  template: |
    tc_pad_pwr_mng #(
      .tc_pad_orientation ( tc_pad_pkg::H              ),
      .tc_pad_config      ( tc_pad_config )
    ) ${instance_name} (
      .ret_en_i ( io_pad_retcin     ),
      .int_io   ( `io_pad_internals )
    );

- name: PAD_PWR_MNG_V
  description: "power management pad, vertical orientation"
  template: |
    tc_pad_pwr_mng #(
      .tc_pad_orientation ( tc_pad_pkg::V              ),
      .tc_pad_config      ( tc_pad_config )
    ) ${instance_name} (
      .ret_en_i ( io_pad_retcin     ),
      .int_io   ( `io_pad_internals )
    );

${'#' * 40}
# CORE AND IO POWER/GROUND SUPPLY PADS
${'#' * 40}

- name: PAD_VDD_CORE_H
  description: "core power domain VDD pad, horizontal orientation"
  template: |
    tc_pad_vdd_core #(
      .tc_pad_orientation ( tc_pad_pkg::H              ),
      .tc_pad_config      ( tc_pad_config )
    ) ${instance_name} (
      .int_io ( `io_pad_internals )
    );

- name: PAD_VDD_CORE_V
  description: "core power domain VDD pad, vertical orientation"
  template: |
    tc_pad_vdd_core #(
      .tc_pad_orientation ( tc_pad_pkg::V              ),
      .tc_pad_config      ( tc_pad_config )
    ) ${instance_name} (
      .int_io ( `io_pad_internals )
    );

