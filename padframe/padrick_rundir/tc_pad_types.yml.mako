      .pu_en_i          ( ${conn('pu_en')}      ),
      .pd_en_i          ( ${conn('pd_en')}      ),
      .schmitt_en_i     ( ${conn('schmitt_en')} ),
      .nand_in_i        ( ${conn('nand_in')}    ),
      .nand_out_o       ( ${conn('nand_out')}   ),
      .chip2pad_i       ( 1'b0                  ),
      .output_en_i      ( 1'b0                  ),
      .slew_en_i        ( 1'b0                  ),
      .drive_strength_i ( ${ds_w}'b0                  ),
      .int_io           ( `io_pad_internals     )
    );

- name: PAD_INPUT_V
  description: "digital input pad, vertical orientation"
  pad_signals: *digital_input_pad_signals
  template: |
